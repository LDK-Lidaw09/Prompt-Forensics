# Copy to .env and adjust. Every variable is optional; defaults are shown.

# --- Model serving -----------------------------------------------------------
# OpenAI-compatible server for unprefixed model ids (vLLM in the thesis).
LIVE_API_BASE=http://127.0.0.1:8000/v1
# LM Studio, for ids prefixed with "lmstudio:".
LMSTUDIO_API_BASE=http://127.0.0.1:1234/v1
# Only for "openai:" and "anthropic:" ids.
OPENAI_API_BASE=https://api.openai.com/v1
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
LIVE_REQUEST_TIMEOUT=300

# --- Models (thesis chapter 5) -------------------------------------------------
LIVE_MODEL=mistralai/Mistral-7B-Instruct-v0.3
JUDGE_MODEL=Qwen/Qwen3-14B
ADVERSARY_MODEL=Qwen/Qwen3-14B

# --- Victim generation (thesis 4.3.1) ----------------------------------------
LIVE_TEMPERATURE=0.2
LIVE_MAX_TOKENS=512
LIVE_SEED=1234

# --- Similarity metrics (thesis 5.2) -----------------------------------------
EMBED_MODEL_NAME=Alibaba-NLP/gte-large-en-v1.5
EMBED_DEVICE=cpu
EMBED_BATCH_SIZE=1
BERTSCORE_LANG=en
# Empty = bert_score default for the language (roberta-large for English).
BERTSCORE_MODEL_TYPE=
SIMILARITY_THRESHOLD=0.9

# --- Evidence store (thesis 4.2) ---------------------------------------------
DB_PATH=./psi_evidence.sqlite
SIGNING_KEY_PATH=./keys/psi_signing_key.pem

# --- Demo chat sessions ------------------------------------------------------
SESSION_MODE=false
SESSION_WINDOW=6

# --- Dataset -------------------------------------------------------------------
SCENARIO_ROOT=data/scenarios
